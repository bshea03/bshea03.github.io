{
  "name": "bshea03-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './app/*' dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "type-check": "pnpm --recursive type-check",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write 'app/*/src/**/*.{ts,tsx,vue}'",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
