{
  "name": "bshea03-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './packages/*' dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "build:client": "pnpm --filter client build",
    "build:server": "pnpm --filter server build",
    "type-check": "pnpm --recursive type-check",
    "lint": "pnpm --recursive lint",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx,vue}'",
    "test": "pnpm --recursive test",
    "clean": "pnpm --recursive exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  }
}
